# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Required: Claude API key (server-side only, never sent to the browser)
ANTHROPIC_API_KEY=

# Required in production: family passcode for the whole site. Leave empty locally to skip the login screen.
FAMILY_PASSCODE=

# Required in production: PIN for grown-up actions (editing word counts, regenerating the methodology).
PARENT_PIN=

# Production database (Neon Postgres via the Vercel integration). Leave empty locally to use the embedded database in ./.data
DATABASE_URL=
