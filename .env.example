# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Required: Claude API key (server-side only, never sent to the browser)
ANTHROPIC_API_KEY=

# Required in production: family passcode for the whole site. Leave empty locally to skip the login screen.
FAMILY_PASSCODE=

# Required in production: one-time setup PIN, asked for when the parent account is first created on the Grown-ups page.
PARENT_PIN=

# Production database (Neon Postgres via the Vercel integration). Leave empty locally to use the embedded database in ./.data
DATABASE_URL=

# Weekly progress emails (Resend: https://resend.com). Without your own domain, Resend can only send to the
# email address you signed up to Resend with, so use that same address for the parent account.
RESEND_API_KEY=
# Optional sender, e.g. "Reading Rocket <rocket@yourdomain.com>" once a domain is verified in Resend.
EMAIL_FROM=

# Random secret that Vercel Cron sends to /api/cron/weekly (Sundays 18:00 UTC). Any long random string.
CRON_SECRET=
